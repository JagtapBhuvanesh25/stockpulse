PORT=4000
DATABASE_URL="file:./dev.db"

# LLM provider: gemini | groq | ollama
LLM_PROVIDER=gemini
LLM_API_KEY=              # ← paste your key here, never commit
LLM_MODEL=gemini-1.5-flash

# Provider base URLs
LLM_BASE_URL=https://generativelanguage.googleapis.com
# Groq:   https://api.groq.com
# Ollama: http://localhost:11434

AI_TIMEOUT_MS=8000

# Initial strategy defaults (overridden at runtime via PUT /config)
PRICING_STRATEGY=rule     # rule | ai
REORDER_STRATEGY=rule
SPIKE_MULTIPLIER=3
